// Hapy MVP — Neon PostgreSQL + Prisma
// Connection URLs live in prisma.config.ts (Prisma 7)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  ASSISTANT
  HUMAN
}

enum ConversationStatus {
  OPEN
  WAITING_HUMAN
  RESOLVED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum Category {
  SUPPORT
  SALES
  PRICING
  TECHNICAL
  GENERAL
}

enum KnowledgeType {
  PDF
  TEXT
  WEB
}

enum CrawlJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RestoreRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for Google-only users
  googleId      String?    @unique // Google "sub" (GIS id-token flow)
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  workspaces    Workspace[]
  agents        Agent[]
  accounts      Account[]
  sessions      Session[]
  auditEvents   AuditEvent[]
  restoreRequests RestoreRequest[]
  assignedConversations Conversation[] @relation("AssignedConversations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents    Agent[]

  @@unique([userId, name])
  @@index([userId])
}

model Agent {
  id                   String              @id @default(cuid())
  userId               String
  workspaceId          String
  name                 String
  description          String?
  systemPrompt         String
  answerStyle          String              @default("DETAILED")
  welcomeMessage       String
  customization        Json?
  publicKey            String?             @unique
  enabled              Boolean             @default(true)
  embedEnabled         Boolean             @default(true)
  siteKnowledgeOrigin  String?             @unique
  siteCrawledAt        DateTime?
  crawlRecrawlHours    Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeDocs        KnowledgeDocument[]
  conversations        Conversation[]
  crawlJobs            SiteCrawlJob[]

  @@index([userId])
  @@index([workspaceId])
}

model KnowledgeDocument {
  id                 String        @id @default(cuid())
  agentId            String
  name               String
  type               KnowledgeType
  content            String // FAQ text, extracted PDF, or crawled website text
  fileUrl            String? // Cloudinary secure_url (PDF only)
  cloudinaryPublicId String? // for destroy on delete (PDF only)
  sourceUrl          String?
  origin             String?
  crawlJobId         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  agent              Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([crawlJobId])
}

model SiteCrawlJob {
  id           String         @id @default(cuid())
  agentId      String
  origin       String
  status       CrawlJobStatus @default(QUEUED)
  pagesCrawled Int            @default(0)
  error        String?
  requestId    String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime       @default(now())
  agent        Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
  @@index([requestId])
}

model Conversation {
  id               String             @id @default(cuid())
  agentId          String
  category         Category?
  sentiment        Sentiment?
  status           ConversationStatus @default(OPEN)
  handoffReason       String?
  handoffSummary      String?
  handoffAt           DateTime?
  handoffCount        Int                @default(0)
  lastHandoffEndedAt  DateTime?
  humanTypingAt       DateTime?
  assignedUserId      String?
  aiPaused            Boolean            @default(false)
  startedAt           DateTime           @default(now())
  endedAt             DateTime?
  createdAt        DateTime           @default(now())
  agent            Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  assignedUser     User?              @relation("AssignedConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages         Message[]

  @@index([agentId])
  @@index([agentId, status, handoffAt])
  @@index([status])
  @@index([category])
  @@index([sentiment])
  @@index([startedAt])
  @@index([assignedUserId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  responseTime   Int?
  feedback       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

model RestoreRequest {
  id        String                @id @default(cuid())
  userId    String
  message   String
  status    RestoreRequestStatus  @default(PENDING)
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
}

model PlatformSettings {
  id                    String   @id @default("global")
  signupsEnabled        Boolean  @default(true)
  maintenanceMode       Boolean  @default(false)
  globalEmbedKill       Boolean  @default(false)
  maxWorkspacesPerUser  Int      @default(20)
  maxAgentsPerWorkspace Int      @default(0)
  /** Mirror of ADMIN_BOOTSTRAP_EMAIL after seed — blocks Google if env drifts */
  reservedAdminEmail    String?
  updatedAt             DateTime @updatedAt
}
