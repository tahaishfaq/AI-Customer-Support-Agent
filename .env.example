# Neon — pooled for app, direct for migrations
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
# PG_POOL_MAX=3
# PG_POOL_IDLE_MS=10000
# PG_POOL_CONNECT_MS=10000

# App origin (one value for Auth.js + public URL; no trailing slash)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
TEST_BASE_URL=http://127.0.0.1:3000

GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
OPENAI_WEB_SEARCH_ENABLED=false
# OPENAI_WEB_SEARCH_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_MS=45000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=aide/knowledge

KNOWLEDGE_MAX_CHARS=12000
KNOWLEDGE_MAX_CHUNKS=12
KNOWLEDGE_MAX_CHUNKS_SCORED=200

SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_V1_SECRET=
BILLING_RECONCILE_ON_REDIRECT=true
# legacy (default) = hosted Safepay /subscribe | atoms = in-AIDE Atoms first pay
BILLING_CHECKOUT_MODE=legacy

RESEND_API_KEY=
# Testing (no domain needed): Aide <beth.t@resend.dev>
# Production: after DNS verify → Aide <noreply@yourdomain.com>
# Manage domains: npm run resend:domain -- list|add|verify
EMAIL_FROM="Aide <beth.t@resend.dev>"
# EMAIL_REPLY_TO=support@yourdomain.com
BILLING_ADMIN_EMAIL=
# EMAIL_TEST_MODE=1
# EMAIL_RESET_OTP_TTL_SEC=300
# EMAIL_RESET_OTP_MAX_ATTEMPTS=5
# EMAIL_RESET_RESEND_COOLDOWN_SEC=60
# EMAIL_VERIFICATION_REQUIRED=0
# EMAIL_LOGIN_ALERTS=0
# EMAIL_ONBOARDING_DRIP=1
# EMAIL_PRODUCT_UPDATES=0
# RATE_LIMIT_FORGOT_PASSWORD=5
# RATE_LIMIT_RESET_PASSWORD=5

# Optional ops
# LOG_LEVEL=info
# LOG_CHAT_SUCCESS=1
# LOG_INFO_SAMPLE_RATE=0.01
# ANALYTICS_TIMEOUT_MS=15000
# CLASSIFY_AFTER_RETURN=0
# CRAWL_DEFER_MS=750
# STREAMING_CHAT=0
# RATE_LIMIT_PUB_CHAT=40
# RATE_LIMIT_STUDIO_CHAT=60
# ACTIONS_CREDENTIALS_KEY=
# ACTIONS_IDENTITY_SECRET=
# ACTIONS_CONFIRMATION_TTL_MS=600000
# WRITE_IDEMPOTENCY_TTL_MS=900000
# DEAD_LETTER_WEBHOOK_URL=

# Realtime Phase 1 — keep secrets in the deployment secret manager.
# REALTIME_ENABLED=0
# REALTIME_DESK_ENABLED=0
# REALTIME_EMBED_ENABLED=0
# REALTIME_BILLING_ENABLED=0
# Optional override. With the one-port Node server, same-origin is automatic.
# REALTIME_URL=https://app.example.com
# REALTIME_TOKEN_SECRET=
# REALTIME_TOKEN_ISSUER=aide-realtime
# REALTIME_TOKEN_AUDIENCE=aide-realtime-client
# REALTIME_TOKEN_TTL_SECONDS=300
# REALTIME_ALLOWED_ORIGINS=http://localhost:3000
# REALTIME_REDIS_URL=rediss://redis.example.com:6379
# REALTIME_REDIS_USERNAME=
# REALTIME_REDIS_PASSWORD=
# REALTIME_STREAM_NAME=aide:realtime:events
# REALTIME_DLQ_STREAM_NAME=aide:realtime:dlq
# REALTIME_CONSUMER_GROUP=aide-realtime-fanout
# REALTIME_CONSUMER_NAME=
# PORT=3000
# REALTIME_MAX_CONNECTIONS=1000
# REALTIME_MAX_CONNECTIONS_PER_USER=10
# REALTIME_MAX_CONNECTIONS_PER_PUBLIC_CONVERSATION=20
# REALTIME_MAX_ROOMS_PER_CONNECTION=10
# REALTIME_MAX_EVENT_BYTES=65536
# REALTIME_CONNECTION_RATE_LIMIT_PER_MINUTE=120
# REALTIME_HEARTBEAT_INTERVAL_SECONDS=25
# REALTIME_GRACEFUL_SHUTDOWN_SECONDS=20
# REALTIME_PUBLISH_BATCH_SIZE=50
# REALTIME_PUBLISH_LEASE_SECONDS=30
# REALTIME_RETRY_MAX_SECONDS=300
# REALTIME_DLQ_AFTER_SECONDS=86400
# REALTIME_STREAM_RETENTION_SECONDS=86400
# REALTIME_STREAM_MAXLEN=100000
# REALTIME_LOG_LEVEL=info
