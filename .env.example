# Neon PostgreSQL — https://console.neon.tech
# Pooled connection (for the app / Prisma Client) — use the host with `-pooler`
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# Direct connection (for Prisma migrations — no -pooler host)
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# Optional pg.Pool sizing per serverless instance (defaults: max 3, idle 10s, connect 10s)
# PG_POOL_MAX=3
# PG_POOL_IDLE_MS=10000
# PG_POOL_CONNECT_MS=10000

# Rate limits (in-memory per instance; burst-friendly defaults)
# RATE_LIMIT_PUB_CHAT=40
# RATE_LIMIT_PUB_CHAT_WINDOW_MS=60000
# RATE_LIMIT_STUDIO_CHAT=60
# RATE_LIMIT_PUB_PING=12
# RATE_LIMIT_REGISTER=8
# F14-E — Confirm / Cancel (stricter than chat)
# RATE_LIMIT_PUB_CONFIRM=20
# RATE_LIMIT_STUDIO_CONFIRM=40
# Opaque host session max TTL (ms); JWT uses its own exp
# IDENTITY_SESSION_MAX_TTL_MS=3600000
# Pending Confirm button TTL (ms, 1m–60m)
# ACTIONS_CONFIRMATION_TTL_MS=600000
# Auth.js (NextAuth v5)
# Production: AUTH_URL and NEXT_PUBLIC_APP_URL must be your HTTPS origin (no trailing slash).
# Local dev + ngrok: keep AUTH_URL=http://localhost:3000 — do NOT change .env when ngrok URL changes.
#   1. ngrok http 3000
#   2. npm run ngrok:webhook-url   → paste webhook into SafePay dashboard
#   3. Open the app in the browser using the ngrok HTTPS URL (not localhost)
# SafePay success/cancel redirects follow that browser host automatically.
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# F11 Agent Actions redesign — encrypt ActionCredential + verify customer identity JWTs
# Production: set dedicated secrets (32+ chars). Dev falls back to AUTH_SECRET if unset.
# ACTIONS_CREDENTIALS_KEY=
# ACTIONS_IDENTITY_SECRET=
# F14-C: host embed may also send userSession { subject, accessToken } (opaque or HS256 JWT)

# Google Sign-In (GIS button / id-token provider)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: full Google OAuth redirect (needs client secret)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_SECRET=

# AI (Phase 4+)
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Cloudinary (PDF knowledge storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder for uploaded PDFs
# CLOUDINARY_FOLDER=aide/knowledge
# (existing clouds may still use hapy/knowledge — keep that value if assets are there)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional ops log verbosity for safe structured logs (info | warn | error)
# LOG_LEVEL=info
# Success chat logs are off by default (errors always kept). Opt-in:
# LOG_CHAT_SUCCESS=1
# Or sample info logs (0–1), e.g. 1%:
# LOG_INFO_SAMPLE_RATE=0.01
# OpenAI: no SDK retries (cost); optional timeout ms (default 45000)
# OPENAI_TIMEOUT_MS=45000

# Phase 1 chat: typing dots in Test Studio (JSON). Set 1 to enable SSE token stream later.
# STREAMING_CHAT=0
# Analytics dashboard wall-clock timeout ms (default 15000) → 503 busy copy
# ANALYTICS_TIMEOUT_MS=15000
# Classify after HTTP return (default on). Set 0 to wait for classify before reply.
# CLASSIFY_AFTER_RETURN=0
# Delay ms before origin crawl job starts (default 750) — reduces chat/crawl pool contention
# CRAWL_DEFER_MS=750
# Future dead-letter alert webhook (F01-F placeholder — logs only until wired)
# DEAD_LETTER_WEBHOOK_URL=

# Optional knowledge stuffing caps (F08-E)
# KNOWLEDGE_MAX_CHARS=12000          — max chars stuffed into the prompt (default 12000)
# KNOWLEDGE_MAX_CHUNKS=12            — max chunks in the prompt (default 12), NOT 200
# KNOWLEDGE_MAX_CHUNKS_SCORED=200    — max chunks ranked before packing (default 200)
# Chunk *size* is ~800–1200 characters each (not env).

# HTTP smoke tests (npm run test:product / test:bugfix / test:admin)
# Local: leave as single URL below, and run `npm run dev` first.
# Do NOT paste "url || url" — one origin only.
TEST_BASE_URL=http://127.0.0.1:3000
# Live / CI: set to your Vercel URL (no trailing slash), e.g.
# TEST_BASE_URL=https://ai-customer-support-agent-ashen.vercel.app
# GitHub Actions: repository secret TEST_BASE_URL = Vercel preview URL

# Admin (exactly one operator). Seed with: npm run seed:admin
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-long-secret
# ADMIN_BOOTSTRAP_NAME=Aide Admin

# ---------------------------------------------------------------------------
# E01 Transactional email (Resend) — docs/features/EMAIL_RESEND_PLAN.md
# Server only. Never prefix with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Aide <noreply@yourdomain.com>"
EMAIL_REPLY_TO=
BILLING_ADMIN_EMAIL=
# EMAIL_VERIFICATION_REQUIRED=1
# EMAIL_LOGIN_ALERTS=0
# EMAIL_ONBOARDING_DRIP=1

# ---------------------------------------------------------------------------
# B01 Billing (SafePay) — docs/features/BILLING_SAFEPAY.md
# Server only. Never prefix with NEXT_PUBLIC_
# Secret key: Developers → API
# Webhook secret: Developers → Webhooks
# Plan IDs (Popular + Teams) go in Admin billing UI, not here
# ---------------------------------------------------------------------------
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_V1_SECRET=
# SAFEPAY_AGGREGATOR_ID=
# Sandbox local dev: activate paid checkout on /billing/success when webhooks cannot reach localhost
# BILLING_RECONCILE_ON_REDIRECT=true
