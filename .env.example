# Neon PostgreSQL — https://console.neon.tech
# Pooled connection (for the app / Prisma Client)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Direct connection (for Prisma migrations — no -pooler host)
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js (NextAuth v5)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Google Sign-In (GIS button / id-token provider)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: full Google OAuth redirect (needs client secret)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_SECRET=

# AI (Phase 4+)
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Cloudinary (PDF knowledge storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder for uploaded PDFs
# CLOUDINARY_FOLDER=hapy/knowledge

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
